{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strawberry-little-bear.github.io/repo-museum/schema/museum-data.schema.json",
  "title": "Repo Museum Data",
  "type": "object",
  "required": ["repo", "name", "events", "dependencies", "analysis", "orientation", "architecture"],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["type", "ref", "label"],
      "properties": {
        "type": { "enum": ["commit", "release", "file", "directory", "issue"] },
        "ref": { "type": "string" },
        "label": { "type": "string" },
        "claim": { "type": "string" }
      }
    },
    "readingGuide": {
      "type": "object",
      "required": ["model", "mode", "language", "headline", "notice", "facts", "symbols", "imports", "boundary"],
      "properties": {
        "model": { "const": "text-structure/v1" },
        "mode": { "enum": ["source", "document", "manifest"] },
        "language": { "type": "string" },
        "headline": { "type": "string", "maxLength": 240 },
        "notice": { "type": "string", "maxLength": 360 },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "line", "signature"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "signature": { "type": "string" }
            }
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "line", "names"],
            "properties": {
              "source": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "names": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "boundary": { "type": "string" }
      }
    },
    "investigationStep": {
      "type": "object",
      "required": ["path", "role", "kind", "prompt", "evidence"],
      "properties": {
        "path": { "type": "string" },
        "role": { "type": "string" },
        "kind": { "type": "string" },
        "prompt": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "investigation": {
      "type": "object",
      "required": ["id", "label", "question", "why", "steps", "finding", "boundary"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "question": { "type": "string" },
        "why": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/investigationStep" }
        },
        "finding": { "type": "string" },
        "boundary": { "type": "string" }
      }
    },
    "repositoryMap": {
      "type": "object",
      "required": ["root", "branch", "truncated", "totalFiles", "totalDirectories", "indexedEntries", "extensions", "directories", "readOrder", "entries", "coverageNote"],
      "properties": {
        "root": { "type": "string" },
        "branch": { "type": "string" },
        "truncated": { "type": "boolean" },
        "totalFiles": { "type": "integer", "minimum": 0 },
        "totalDirectories": { "type": "integer", "minimum": 0 },
        "indexedEntries": { "type": "integer", "minimum": 0 },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["extension", "count"],
            "properties": {
              "extension": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "count"],
            "properties": {
              "path": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "readOrder": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role", "why", "kind", "evidence"],
            "properties": {
              "path": { "type": "string" },
              "role": { "type": "string" },
              "why": { "type": "string" },
              "kind": { "type": "string" },
              "evidence": { "type": "string" },
              "preview": { "type": "string", "maxLength": 60000 },
              "readingGuide": { "$ref": "#/$defs/readingGuide" }
            }
          }
        },
        "investigations": {
          "type": "array",
          "items": { "$ref": "#/$defs/investigation" }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "type", "category", "role"],
            "properties": {
              "path": { "type": "string" },
              "type": { "enum": ["file", "directory"] },
              "category": { "type": "string" },
              "role": { "type": "string" },
              "extension": { "type": "string" },
              "size": { "type": ["integer", "null"] },
              "count": { "type": "integer", "minimum": 0 },
              "preview": { "type": "string", "maxLength": 60000 }
            }
          }
        },
        "coverageNote": { "type": "string" }
      }
    }
  },
  "properties": {
    "repo": { "type": "string" },
    "name": { "type": "string" },
    "htmlUrl": { "type": "string" },
    "events": { "type": "array", "items": { "type": "object" } },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "repositoryMap": { "$ref": "#/$defs/repositoryMap" },
    "learning": {
      "type": "object",
      "required": ["promise", "rooms"],
      "properties": {
        "promise": { "type": "string" },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "question", "takeaway", "mode"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "question": { "type": "string" },
              "scene": { "type": "string" },
              "plain": { "type": "string" },
              "reveal": { "type": "string" },
              "whyItMatters": { "type": "string" },
              "interaction": { "type": "string" },
              "takeaway": { "type": "string" },
              "mode": { "enum": ["observed", "inferred", "mixed"] },
              "discovery": { "type": "string" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
              "evidenceTrail": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
            }
          }
        }
      }
    },
    "orientation": {
      "type": "object",
      "required": ["what", "oneLine", "use", "how"],
      "properties": {
        "what": { "type": "string" },
        "oneLine": { "type": "string" },
        "use": { "type": "string" },
        "how": { "type": "string" },
        "outcome": { "type": "string" },
        "example": { "type": "string" },
        "guide": { "type": "string" },
        "sourceNote": { "type": "string" }
      }
    },
    "journey": {
      "type": "object",
      "properties": {
        "intro": { "type": "string" },
        "summary": { "type": "string" },
        "sourceNote": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "plain", "technical"],
            "properties": {
              "number": { "type": "string" },
              "label": { "type": "string" },
              "title": { "type": "string" },
              "plain": { "type": "string" },
              "technical": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "plain"],
            "properties": {
              "term": { "type": "string" },
              "plain": { "type": "string" }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["summary", "folders", "files", "entrypoints"],
      "properties": {
        "summary": { "type": "string" },
        "flow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "role", "detail"],
            "properties": {
              "label": { "type": "string" },
              "role": { "type": "string" },
              "detail": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        },
        "folders": { "type": "array", "items": { "type": "object" } },
        "files": { "type": "array", "items": { "type": "object" } },
        "entrypoints": { "type": "array", "items": { "type": "string" } },
        "sourceNote": { "type": "string" }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["headline", "thesis", "arc"],
      "properties": {
        "headline": { "type": "string" },
        "thesis": { "type": "string" },
        "historySummary": { "type": "string" },
        "exit": { "type": "string" },
        "confidence": { "type": "string" },
        "turningPointReason": { "type": "string" },
        "distinctDates": { "type": "integer", "minimum": 0 },
        "excludedSameDayEvents": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "string" },
        "discovery": {
          "type": "object",
          "required": ["label", "title", "summary", "whyItMatters", "mode", "evidence", "route", "boundary"],
          "properties": {
            "label": { "type": "string" },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "whyItMatters": { "type": "string" },
            "mode": { "enum": ["observed", "inferred", "mixed"] },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/evidence" }
            },
            "route": { "type": "string" },
            "boundary": { "type": "string" }
          }
        },
        "arc": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "lesson": { "type": "string" },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
            }
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "role", "start", "end", "title", "summary", "lesson", "commitCount", "reason", "evidence", "coverage"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "role": { "enum": ["origin", "turning", "now"] },
              "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "lesson": { "type": "string" },
              "commitCount": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string" },
              "coverage": { "type": "string" },
              "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
            }
          }
        },
        "signals": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
