{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strawberry-little-bear.github.io/repo-museum/schema/museum-data.schema.json",
  "title": "Repo Museum Data",
  "type": "object",
  "required": ["repo", "name", "events", "dependencies", "analysis", "orientation", "architecture"],
  "properties": {
    "repo": { "type": "string" },
    "name": { "type": "string" },
    "htmlUrl": { "type": "string" },
    "events": { "type": "array", "items": { "type": "object" } },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "learning": {
      "type": "object",
      "required": ["promise", "rooms"],
      "properties": {
        "promise": { "type": "string" },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "question", "takeaway", "mode"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "question": { "type": "string" },
              "scene": { "type": "string" },
              "plain": { "type": "string" },
              "reveal": { "type": "string" },
              "whyItMatters": { "type": "string" },
              "interaction": { "type": "string" },
              "takeaway": { "type": "string" },
              "mode": { "enum": ["observed", "inferred", "mixed"] },
              "evidence": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "orientation": {
      "type": "object",
      "required": ["what", "oneLine", "use", "how"],
      "properties": {
        "what": { "type": "string" },
        "oneLine": { "type": "string" },
        "use": { "type": "string" },
        "how": { "type": "string" },
        "outcome": { "type": "string" },
        "example": { "type": "string" },
        "guide": { "type": "string" },
        "sourceNote": { "type": "string" }
      }
    },
    "journey": {
      "type": "object",
      "properties": {
        "intro": { "type": "string" },
        "summary": { "type": "string" },
        "sourceNote": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "plain", "technical"],
            "properties": {
              "number": { "type": "string" },
              "label": { "type": "string" },
              "title": { "type": "string" },
              "plain": { "type": "string" },
              "technical": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "plain"],
            "properties": {
              "term": { "type": "string" },
              "plain": { "type": "string" }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["summary", "folders", "files", "entrypoints"],
      "properties": {
        "summary": { "type": "string" },
        "flow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "role", "detail"],
            "properties": {
              "label": { "type": "string" },
              "role": { "type": "string" },
              "detail": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        },
        "folders": { "type": "array", "items": { "type": "object" } },
        "files": { "type": "array", "items": { "type": "object" } },
        "entrypoints": { "type": "array", "items": { "type": "string" } },
        "sourceNote": { "type": "string" }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["headline", "thesis", "arc"],
      "properties": {
        "headline": { "type": "string" },
        "thesis": { "type": "string" },
        "historySummary": { "type": "string" },
        "exit": { "type": "string" },
        "confidence": { "type": "string" },
        "arc": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "lesson": { "type": "string" },
              "evidence": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "signals": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
